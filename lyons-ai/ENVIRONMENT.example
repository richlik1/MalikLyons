# LYONS AI: environment variables (NAMES AND DESCRIPTIONS ONLY)
# This file intentionally contains no values. Real values live only in the
# server's .env (chmod 600), which deploy/setup.sh generates. .env.example has the
# same names with non-secret defaults. Never commit real values anywhere.
# Legend: [required] [generated by setup.sh] [optional] [default shown in .env.example]

# --- Runtime ---
NODE_ENV=                 # production | development
LOG_LEVEL=                # pino level (info)
TIMEZONE=                 # IANA zone for schedules and briefs (America/Detroit)
HTTP_HOST=                # bind address (0.0.0.0 in container)
HTTP_PORT=                # HTTP port (8080)
PUBLIC_BASE_URL=          # [generated] https://<host>; used for OAuth redirect and Twilio URLs
LYONS_DOMAIN=             # [generated] hostname Caddy gets a TLS certificate for (docker-compose)
ARTIFACTS_DIR=            # where browser screenshots are stored

# --- Database ---
DATABASE_URL=             # Postgres URL (set by docker-compose from POSTGRES_PASSWORD)
POSTGRES_PASSWORD=        # [generated] password for the lyons DB user (docker-compose)
N8N_DB_PASSWORD=          # [generated] password for the n8n DB user (docker-compose)

# --- Secrets for encryption and signing ---
MASTER_ENCRYPTION_KEY=    # [required][generated] base64 32-byte key; encrypts stored OAuth tokens. Losing it means reconnecting Google.
WEBHOOK_SHARED_SECRET=    # [generated] HMAC secret for n8n → /hooks/* requests
N8N_ENCRYPTION_KEY=       # [generated] n8n credential encryption key
CONTROL_CENTER_TOKEN=     # [generated] sign-in token for /control (empty disables the dashboard)

# --- Claude ---
ANTHROPIC_API_KEY=        # [required] Anthropic API key
CLAUDE_MODEL=             # model id (claude-opus-5-5)
CLAUDE_EFFORT=            # low | medium | high
CLAUDE_FALLBACKS=         # server-side model fallbacks ("default")
CLAUDE_MAX_TOKENS=        # max output tokens per call

# --- Telegram ---
TELEGRAM_BOT_TOKEN=       # [required] from @BotFather
TELEGRAM_OWNER_USER_ID=   # [required] numeric Telegram user id; the only account the bot answers

# --- Google (Gmail, Calendar, Contacts) ---
GOOGLE_CLIENT_ID=         # [optional] OAuth client (web application) id
GOOGLE_CLIENT_SECRET=     # [optional] OAuth client secret. Redirect URI: ${PUBLIC_BASE_URL}/oauth/google/callback

# --- StayOps (read-only adapter, not connected yet) ---
STAYOPS_API_BASE_URL=     # [optional] StayOps API base URL
STAYOPS_API_TOKEN=        # [optional] scoped read-only token issued by StayOps
STAYOPS_TASKS_ENABLED=    # true lets "Pursue" create a StayOps task (false)

# --- Browser automation ---
BROWSER_ALLOWED_DOMAINS=  # comma-separated allowlist; empty blocks everything
BROWSER_EXECUTABLE_PATH=  # optional Chromium path
BROWSER_TIMEOUT_MS=       # per-page timeout

# --- Opportunity Intelligence ---
OPP_ENABLED=              # true | false
OPP_MORNING_HOUR=         # morning cycle hour in TIMEZONE (7)
OPP_EVENING_HOUR=         # evening cycle hour in TIMEZONE (19)
OPP_WEB_UNITS_PER_CYCLE=  # web-research units per cycle (3)
OPP_WEB_RESEARCH=         # enable Claude web research (true)
OPP_DAILY_RESEARCH_BUDGET_USD= # cap on research LLM spend per day
OPP_MAX_ALERTS_PER_DAY=   # cap on exceptional alerts
OPP_MAX_VERIFICATIONS_PER_RUN= # verification calls per discovery run
OPP_WEEKLY_ENABLED=       # weekly top-5 report (false)
OPP_WEEKLY_DAY=           # 0=Sunday … 6
OPP_WEEKLY_HOUR=          # hour for the weekly report
SAM_API_KEY=              # [optional] SAM.gov public API key (contracts source)
GITHUB_TOKEN=             # [optional] GitHub token with no scopes (raises rate limit)
# Deprecated and unused by the current scheduler (still parsed): OPP_DISCOVERY_EVERY_HOURS, OPP_DAILY_HOUR, OPP_DAILY_ITEMS

# --- Mac bridge (iMessage and storage) ---
MAC_BRIDGE_SECRET=        # [optional] HMAC secret shared with the Mac (empty disables /bridge/*)
# On the Mac (not the server): LYONS_BASE_URL, LYONS_BRIDGE_SECRET (= MAC_BRIDGE_SECRET), LYONS_BRIDGE_DRY_RUN=1

# --- Receptionist (Twilio) ---
RECEPTIONIST_ENABLED=     # true | false
TWILIO_AUTH_TOKEN=        # [optional] validates Twilio webhook signatures
OWNER_PHONE=              # [optional] number calls are forwarded or escalated to
RECEPTIONIST_MODEL=       # model for live calls
RECEPTIONIST_EFFORT=      # low recommended for latency
RECEPTIONIST_VOICE=       # Twilio voice name
RECEPTIONIST_MAX_TURNS=   # conversation turns per call

# --- Safety limits ---
DAILY_SPEND_LIMIT_USD=    # hard daily Claude spend cap
TASK_SPEND_LIMIT_USD=     # per-task spend cap
TASK_TIMEOUT_MS=          # per-task wall-clock timeout
MAX_AGENT_TURNS=          # model turns per task
APPROVAL_TTL_HOURS=       # approvals expire and count as rejected after this
WORKER_CONCURRENCY=       # parallel tasks
