# LYONS AI configuration. Copy to .env on the server (chmod 600) and fill in.
# Never commit .env. Never paste these values into Telegram or chat.

# --- Core -------------------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info
TIMEZONE=America/New_York
# Generate with: openssl rand -base64 32   (losing it = re-connect Google accounts)
MASTER_ENCRYPTION_KEY=

# --- Database (docker-compose builds DATABASE_URL from POSTGRES_PASSWORD) ---
# Generate alphanumeric passwords with: openssl rand -hex 24
POSTGRES_PASSWORD=
N8N_DB_PASSWORD=
# Only needed when running outside docker-compose:
# DATABASE_URL=postgres://lyons:PASSWORD@localhost:5432/lyons

# --- Claude -----------------------------------------------------------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (higher = smarter, slower, more expensive)
CLAUDE_EFFORT=medium
# "default" retries a declined request on Anthropic's recommended fallback model; "off" disables
CLAUDE_FALLBACKS=default
CLAUDE_MAX_TOKENS=16000

# --- Telegram ---------------------------------------------------------------
# From @BotFather. Your numeric user id from @userinfobot. Only this id can use the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_USER_ID=

# --- Public URL (only the Google OAuth callback is exposed) ---------------------
LYONS_DOMAIN=agent.example.com
PUBLIC_BASE_URL=https://agent.example.com

# --- n8n -> agent webhooks --------------------------------------------------
# Generate with: openssl rand -hex 32
WEBHOOK_SHARED_SECRET=
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# --- Google (one OAuth client; business and personal accounts connect separately)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- StayOps (optional; read-only token. Tool is disabled until both are set)
STAYOPS_API_BASE_URL=
STAYOPS_API_TOKEN=

# --- Browser automation (comma-separated domains; empty = disabled) ----------
BROWSER_ALLOWED_DOMAINS=
BROWSER_TIMEOUT_MS=45000
# Leave empty in Docker (the image bundles Chromium)
BROWSER_EXECUTABLE_PATH=

# --- Safety limits ------------------------------------------------------------
DAILY_SPEND_LIMIT_USD=5
TASK_SPEND_LIMIT_USD=1
TASK_TIMEOUT_MS=600000
MAX_AGENT_TURNS=20
APPROVAL_TTL_HOURS=24
WORKER_CONCURRENCY=2
