# LYONS AI configuration. Copy to .env on the server (chmod 600) and fill in.
# Never commit .env. Never paste these values into Telegram or chat.

# --- Core -------------------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info
TIMEZONE=America/Detroit
# Generate with: openssl rand -base64 32   (losing it = re-connect Google accounts)
MASTER_ENCRYPTION_KEY=

# --- Database (docker-compose builds DATABASE_URL from POSTGRES_PASSWORD) ---
# Generate alphanumeric passwords with: openssl rand -hex 24
POSTGRES_PASSWORD=
N8N_DB_PASSWORD=
# Only needed when running outside docker-compose:
# DATABASE_URL=postgres://lyons:PASSWORD@localhost:5432/lyons

# --- Claude -----------------------------------------------------------------
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (higher = smarter, slower, more expensive)
CLAUDE_EFFORT=medium
# "default" retries a declined request on Anthropic's recommended fallback model; "off" disables
CLAUDE_FALLBACKS=default
CLAUDE_MAX_TOKENS=16000

# --- Telegram ---------------------------------------------------------------
# From @BotFather. Your numeric user id from @userinfobot. Only this id can use the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_USER_ID=

# --- Public URL (only the Google OAuth callback is exposed) ---------------------
LYONS_DOMAIN=agent.example.com
PUBLIC_BASE_URL=https://agent.example.com

# --- n8n -> agent webhooks --------------------------------------------------
# Generate with: openssl rand -hex 32
WEBHOOK_SHARED_SECRET=
# Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# --- Google (one OAuth client; business and personal accounts connect separately)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- StayOps (optional; read-only token. Tool is disabled until both are set)
STAYOPS_API_BASE_URL=
STAYOPS_API_TOKEN=

# --- Browser automation (comma-separated domains; empty = disabled) ----------
BROWSER_ALLOWED_DOMAINS=
BROWSER_TIMEOUT_MS=45000
# Leave empty in Docker (the image bundles Chromium)
BROWSER_EXECUTABLE_PATH=

# --- Control Center (/control, private port) ---------------------------------
# Generate with: openssl rand -hex 32   (empty = dashboard disabled)
CONTROL_CENTER_TOKEN=

# --- Opportunity Intelligence -------------------------------------------------
OPP_ENABLED=true
# Free key: sam.gov -> Account Details -> API key (empty = federal contract search off)
SAM_API_KEY=
# Twice-daily cycles in TIMEZONE: morning discovery + brief, evening recheck + review
OPP_MORNING_HOUR=7
OPP_EVENING_HOUR=19
# Web-research units per cycle, split across departments 30/20/15/15/10/10
OPP_WEB_UNITS_PER_CYCLE=3
OPP_WEEKLY_ENABLED=false
OPP_WEEKLY_DAY=1
OPP_WEEKLY_HOUR=8
OPP_MAX_ALERTS_PER_DAY=2
# Optional: raises GitHub API limit from 60 to 5,000 requests/hour (no scopes needed)
GITHUB_TOKEN=
# Create a StayOps task when you tap Pursue (needs STAYOPS_API_BASE_URL/TOKEN)
STAYOPS_TASKS_ENABLED=false
OPP_WEB_RESEARCH=true
OPP_DAILY_RESEARCH_BUDGET_USD=1.5

# --- Mac bridge (iMessage + storage) ------------------------------------------
# Generate with: openssl rand -hex 32   (empty = bridge endpoints disabled)
MAC_BRIDGE_SECRET=

# --- AI receptionist (Twilio Voice) -------------------------------------------
RECEPTIONIST_ENABLED=false
TWILIO_AUTH_TOKEN=
# Your phone for urgent transfers, E.164 format
OWNER_PHONE=
RECEPTIONIST_MODEL=claude-opus-5-5
RECEPTIONIST_EFFORT=low
RECEPTIONIST_VOICE=Polly.Joanna-Neural
RECEPTIONIST_MAX_TURNS=6

# --- Safety limits ------------------------------------------------------------
DAILY_SPEND_LIMIT_USD=5
TASK_SPEND_LIMIT_USD=1
TASK_TIMEOUT_MS=600000
MAX_AGENT_TURNS=20
APPROVAL_TTL_HOURS=24
WORKER_CONCURRENCY=2
