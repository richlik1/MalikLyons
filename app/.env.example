# Run `npm run check:env` after filling this in. It reports problems by name, never values.

# development | staging | production. Staging/production are PRIVATE (HTTP Basic auth, noindex)
# unless SITE_ACCESS_MODE=public AND PUBLIC_LAUNCH_APPROVED=true.
APP_ENV=development
SITE_ACCESS_MODE=private
SITE_ACCESS_PASSWORD=
PUBLIC_LAUNCH_APPROVED=false

# --- Public (safe to expose to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server only. Never prefix these with NEXT_PUBLIC_. ---
SUPABASE_SERVICE_ROLE_KEY=

# Which try-on provider to use: "fashn" or "google-vertex".
# If unset or misconfigured, the try-on page says the provider is unavailable. There is no fake fallback.
TRYON_PROVIDER=fashn

# FASHN (https://fashn.ai) — verify current pricing before launch.
FASHN_API_KEY=
FASHN_MODEL=tryon-v1.6
# Cost estimate per successful image in USD, used for cost monitoring only (not billing).
FASHN_COST_PER_IMAGE_USD=0.075
# Local contract testing only (scripts/fashn-stub.mjs). check:env rejects this outside development.
# FASHN_BASE_URL=http://127.0.0.1:54340/v1

# Google Vertex AI Virtual Try-On. virtual-try-on-001 lists a retirement date of 2027-03-15.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
VERTEX_TRYON_MODEL=virtual-try-on-001
# Service-account JSON (single line). Alternatively rely on workload identity / ADC.
GOOGLE_APPLICATION_CREDENTIALS_JSON=
VERTEX_COST_PER_IMAGE_USD=0.06

# Usage limits (privacy-first and cost-safe defaults)
TRYON_LIMIT_PER_USER_PER_MINUTE=2
TRYON_LIMIT_PER_USER_PER_DAY=15
TRYON_GLOBAL_DAILY_BUDGET_USD=20
PERSON_PHOTO_RETENTION_DAYS=30
# >= 32 chars. Protects /api/cron/purge and the detailed /api/health report.
CRON_SECRET=

# Billing: this build only supports "disabled" or "shadow". "live" is rejected.
BILLING_MODE=disabled

# Shopify app (all four or none). Key: `openssl rand -base64 32`
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_products,read_orders
SHOPIFY_TOKEN_ENCRYPTION_KEY=
# SHOPIFY_API_VERSION=2025-10
